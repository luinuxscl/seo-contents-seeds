{
    "name": "luinuxscl/seo-content-seeds",
    "description": "Paquete Laravel para obtener ideas para la creación de contenido SEO desde diversas fuentes externas",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LuinuxSCL",
            "email": "luinuxscl@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },

    "autoload": {
        "psr-4": {
            "Luinuxscl\\SeoContentSeeds\\": "src/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "Luinuxscl\\SeoContentSeeds\\Providers\\SeoContentSeedsServiceProvider"
            ],
            "aliases": {
                "SeoContentSeeds": "Luinuxscl\\SeoContentSeeds\\Facades\\SeoContentSeeds"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
